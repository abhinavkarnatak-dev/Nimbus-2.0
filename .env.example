# Local PostgreSQL started by docker-compose.yml.
DATABASE_URL=postgresql://nimbus:nimbus@localhost:55432/nimbus
# Local Redis used for coordination, never durable task state.
REDIS_URL=redis://localhost:6379
# Development-only sign-in. The application rejects it in production.
NIMBUS_LOCAL_AUTH=true
# Use fake locally. Use codex only with an approved ChatGPT OAuth token flow.
NIMBUS_CODING_PROVIDER=fake
# Local bootstrap only. Production credentials must come from the encrypted OAuth broker.
# NIMBUS_CODEX_ACCESS_TOKEN=
# Keep disabled until an approved Sign in with ChatGPT client is configured.
NIMBUS_CHATGPT_OAUTH_ENABLED=false
# GitHub App values are required only when the live GitHub integration is enabled.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_CALLBACK_URL=http://localhost:3000/api/github/callback
# GITHUB_APP_PRIVATE_KEY_BASE64=
# GITHUB_APP_WEBHOOK_SECRET=
# Local executor health endpoint.
EXECUTOR_PORT=3020
