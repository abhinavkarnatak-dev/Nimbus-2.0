{
  "name": "@nimbus/executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env.local dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nimbus/codex": "workspace:*",
    "@nimbus/database": "workspace:*",
    "@nimbus/observability": "workspace:*",
    "@nimbus/shared": "workspace:*",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
