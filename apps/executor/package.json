{
  "name": "@nimbus/executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env.local dist/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2b": "node --env-file-if-exists=.env.local --import tsx src/e2b-live-test.ts",
    "test:e2b-protocol": "node --env-file-if-exists=.env.local --import tsx src/e2b-exec-live-test.ts"
  },
  "dependencies": {
    "@nimbus/codex": "workspace:*",
    "@nimbus/database": "workspace:*",
    "@nimbus/observability": "workspace:*",
    "@nimbus/shared": "workspace:*",
    "drizzle-orm": "0.45.3",
    "e2b": "2.52.1",
    "tsx": "4.20.6",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "@types/node": "24.7.0",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
