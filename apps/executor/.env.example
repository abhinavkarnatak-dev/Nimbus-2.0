# Task worker only. GitHub App credentials do not belong here.
DATABASE_URL=postgresql://nimbus:nimbus@localhost:55432/nimbus
EXECUTOR_PORT=3020
# Explicit local simulation. Production rejects fake mode.
NIMBUS_CODING_PROVIDER=fake
# Optional development bootstrap using an approved short-lived ChatGPT OAuth token.
# Normal users do not need to supply this; no API-key fallback is supported.
# NIMBUS_CODEX_ACCESS_TOKEN=

# E2B provisioning credential required for real connected Codex sessions.
# Set only in apps/executor/.env.local. Never pass it into sandbox env or files.
# Real sessions execute in E2B; fake mode remains an explicit local simulation.
E2B_API_KEY=

# PostHog operational events. Use the same project token as the web service.
# This is a project token (phc_...), not a personal API key (phx_...).
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_SERVICE_NAME=nimbus-executor
POSTHOG_DEPLOYMENT_ENVIRONMENT=development
