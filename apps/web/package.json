    "pdfjs-dist": "6.4.299",
    "@nimbus/codex": "workspace:*",
    "@nimbus/database": "workspace:*",
    "@nimbus/github": "workspace:*",
    "@nimbus/observability": "workspace:*",
    "@nimbus/shared": "workspace:*",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-tabs": "1.1.13",
    "@tanstack/react-query": "5.90.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "dompurify": "3.4.16",
