# Next.js UI and server-side control plane only. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=postgresql://nimbus:nimbus@localhost:55432/nimbus
NIMBUS_LOCAL_AUTH=true
NIMBUS_CODING_PROVIDER=fake
NIMBUS_CHATGPT_OAUTH_ENABLED=false

# Required together for a live GitHub connection. Keep secrets server-side.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=http://localhost:3000/api/github/callback
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=
