# Next.js UI and server-side control plane only. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=postgresql://nimbus:nimbus@localhost:55432/nimbus
NIMBUS_LOCAL_AUTH=true
NIMBUS_CODING_PROVIDER=fake
# Hosted connected runtime: account slots and active CLI processes are separate.
# See docs/operations/server-device-login.md for all required hosted settings.
NIMBUS_CODEX_MAX_CONNECTIONS=2
NIMBUS_CODEX_MAX_PROCESSES=1
NIMBUS_CODEX_IDLE_MS=45000
# Google identifies the Nimbus user. Codex authorization is a separate connection.
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional PR notification emails. Missing values disable emails, not task execution.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public URL reader: direct HTML reads need no key. Remote JS rendering uses
# Jina Reader (public URLs are shared with that service; no user credentials).
# Optional server-only key enables authenticated limits and iframe content.
JINA_API_KEY=

# PostHog project token (phc_...) and ingestion host. Project tokens are
# intentionally public; never put a PostHog personal API key in NEXT_PUBLIC_.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional server-side override. If omitted, web error events reuse the public
# project token and host above.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Required together for a live GitHub connection. Keep secrets server-side.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=http://localhost:3000/api/github/callback
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=
# Private R2 attachments: account endpoint only (no bucket suffix).
R2_ENDPOINT=
R2_BUCKET_NAME=nimbus2-attachments
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
